{
  "name": "wosamma",
  "version": "0.0.4",
  "private": true,
  "description": "A map visualization of GPS tracks from past sailing trips",
  "keywords": [
    "gps",
    "map",
    "sailing",
    "track",
    "trip",
    "typescript",
    "visualization",
    "web"
  ],
  "license": "MIT",
  "author": "Martin Rohrmeier <roryphant@gmail.com> (oyo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oyo/wosamma.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "simplify": "ts-node ./src/scripts/simplify.ts",
    "inject-auth": "ts-node ./src/scripts/injectAuth.ts > src/auth/authSettings.json"
  },
  "dependencies": {
    "drop.that": "^0.1.1",
    "leaflet": "^1.9.4",
    "oidc-client-ts": "^3.5.0",
    "trackutil": "^0.0.9",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "glob": "^13.0.6",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "download"
    }
  }
}
